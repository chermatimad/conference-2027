{
  "name": "conference-2027-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "seed": "node seed/build-seed.mjs",
    "import-seed": "node seed/build-seed.mjs && sanity dataset import seed/seed.ndjson production --missing",
    "import-docx": "node seed/build-seed.mjs && sanity dataset import seed/seed-docx.ndjson production --replace",
    "patch-settings": "sanity exec seed/patch-settings.mjs --with-user-token",
    "patch-names": "sanity exec seed/patch-names.mjs --with-user-token",
    "sync-committee": "sanity exec seed/sync-committee.mjs --with-user-token",
    "sync-committee-apply": "sanity exec seed/sync-committee.mjs --with-user-token -- --apply"
  },
  "dependencies": {
    "@sanity/vision": "^4",
    "react": "^19",
    "react-dom": "^19",
    "sanity": "^4",
    "styled-components": "^6.1.15"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
